{
  "name": "dsh-rea-reverse-preset",
  "version": "1.0.0",
  "displayName": "逆向工程模式 · Reverse Engineering",
  "description": "逆向工程模式 for DeepSeek Harness: one preset that mounts ~139 REA tools (Ghidra / Hopper / IDA), a reverse-engineer persona, and an evidence-first analysis workflow.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "agent",
    "agent-preset",
    "preset",
    "tool",
    "cli",
    "debugger",
    "reverse-engineering",
    "disassembler",
    "decompiler",
    "rea",
    "mcp",
    "ghidra",
    "hopper",
    "ida"
  ],
  "type": "module",
  "bin": {
    "dsh-rea-setup": "scripts/setup.mjs",
    "dsh-rea-reverse-preset": "scripts/setup.mjs"
  },
  "license": "MIT",
  "icon": "./icon.png",
  "files": [
    "cordis.patch.yml",
    "skills",
    "tui",
    "docs",
    "scripts",
    "icon.png",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:profiles": "node scripts/check-profiles.mjs",
    "sync:tui": "node scripts/sync-tui.mjs",
    "sync:tui:check": "node scripts/sync-tui.mjs --check",
    "link:desktop": "node scripts/install.mjs --profile desktop",
    "link:web": "node scripts/install.mjs --profile web",
    "link:headless": "node scripts/install.mjs --profile headless",
    "link:tui": "node scripts/install.mjs --profile dsh-tui",
    "link:all": "node scripts/install.mjs --all",
    "unlink:all": "node scripts/install.mjs --all --uninstall",
    "publish:check": "node scripts/publish-check.mjs",
    "market:check": "node scripts/market-check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=20.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verisw/rea-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/Verisw/rea-dsh/issues"
  },
  "homepage": "https://github.com/Verisw/rea-dsh#readme"
}
